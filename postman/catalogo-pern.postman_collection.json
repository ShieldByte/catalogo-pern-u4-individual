{
  "info": {
    "name": "Catálogo PERN · U4 individual",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Peticiones de las jornadas 1 a 4 e INV01. Cambia la variable baseUrl a la URL de Render para probar el despliegue."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    }
