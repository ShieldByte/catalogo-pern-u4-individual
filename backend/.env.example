# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Cadena de conexión de Neon (Dashboard > Connection string)
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT=3000
# Origen del frontend en desarrollo (Vite)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Secreto para firmar los tokens de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Opcional: clave de Arcjet para limitar solicitudes y detectar bots (https://arcjet.com)
ARCJET_KEY=
